# Two commercetools projects: STAGE (author + QA) and LIVE (production).
# Each var may be prefixed STAGE_ or LIVE_. If a prefixed var is missing, the
# client falls back to the un-prefixed CTP_* (handy for local dev, and picked
# up automatically from a sibling .env). Until the STAGE project is provisioned,
# leave STAGE_* unset so BOTH projects resolve to the LIVE one — that enables the
# live→live self-test.

# LIVE (production) — your-live-project
LIVE_CTP_PROJECT_KEY=your-live-project
LIVE_CTP_CLIENT_ID=xxx
LIVE_CTP_CLIENT_SECRET=xxx
LIVE_CTP_AUTH_URL=https://auth.us-central1.gcp.commercetools.com
LIVE_CTP_API_URL=https://api.us-central1.gcp.commercetools.com

# STAGE (author/QA) — your-stage-project (set once provisioned)
STAGE_CTP_PROJECT_KEY=your-stage-project
STAGE_CTP_CLIENT_ID=xxx
STAGE_CTP_CLIENT_SECRET=xxx
STAGE_CTP_AUTH_URL=https://auth.us-central1.gcp.commercetools.com
STAGE_CTP_API_URL=https://api.us-central1.gcp.commercetools.com

# HTTP service auth: MC app calls the service with this shared secret (Bearer).
DEPLOY_SERVICE_TOKEN=change-me
PORT=8080

# ── Email notifications (best-effort; a mail failure never blocks a transition) ──
# Recipients are resolved from the release-acl roles on stage:
#   author submits (→ ready-for-review)  → emails everyone who can approve (reviewers)
#   reviewer approves (→ approved)        → emails everyone who can publish (publishers)
#   release published to production       → emails the author
#   release rejected / sent back          → emails the author
#
# EMAIL_ENABLED=false fully disables. With no provider key set the service uses the
# "log" transport (prints the intended email to the service log) so nothing breaks
# and you can see notifications without a real email account.
EMAIL_ENABLED=true
# resend | sendgrid | postmark | log  — auto-detected from the *_API_KEY set below
# if left blank; falls back to "log".
EMAIL_PROVIDER=
EMAIL_FROM=Release Service <releases@example.com>
EMAIL_REPLY_TO=
EMAIL_TIMEOUT_MS=5000
# Optional: base URL for a deep link into the MC app; the email links to ${base}/${key}
# e.g. https://mc.us-central1.gcp.commercetools.com/your-stage-project/reference-deployment-releases/releases
EMAIL_RELEASE_LINK_BASE=
# Provide exactly one key for the chosen provider:
RESEND_API_KEY=
SENDGRID_API_KEY=
POSTMARK_SERVER_TOKEN=
