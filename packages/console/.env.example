# Release Manager environment.
#
# Copy to .env.local for local development and set the same values in your host's
# environment for a deploy. Only the REQUIRED block is needed to boot; everything
# under OPTIONAL has a working default.
#
# Full reference: docs/configuration.md

# =============================================================================
# REQUIRED
# =============================================================================

# --- AUTHORING project: catalog, releases, and this console's own user accounts ---
# Console users are commercetools Customers here; their roles are `rm-acl` custom
# objects in the same project. manage_project covers all of it.
# Mint with: node tools/ensure-client.mjs authoring >> .env.local
CTP_PROJECT_KEY=
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
CTP_AUTH_URL=https://auth.us-central1.gcp.commercetools.com
CTP_API_URL=https://api.us-central1.gcp.commercetools.com
CTP_SCOPES=

# --- PRODUCTION project: read-only, the dashboard's sales analytics ---
# Mint with: node tools/ensure-client.mjs production >> .env.local
PROD_CTP_PROJECT_KEY=
PROD_CTP_CLIENT_ID=
PROD_CTP_CLIENT_SECRET=
PROD_CTP_AUTH_URL=https://auth.us-central1.gcp.commercetools.com
PROD_CTP_API_URL=https://api.us-central1.gcp.commercetools.com
PROD_CTP_SCOPES=

# --- release-deploy service: owns branch, fork, merge, deploy and rollback ---
RELEASE_SERVICE_URL=
RELEASE_SERVICE_TOKEN=

# --- session signing: any long random string ---
# openssl rand -base64 48
SESSION_SECRET=

# --- the one account that can sign in before the access list has anyone in it ---
# Everyone else is refused until an admin grants them a role, so set this or nobody
# can get into a fresh install.
BOOTSTRAP_ADMIN_EMAIL=

# =============================================================================
# OPTIONAL — branding
# NEXT_PUBLIC_* values are baked into the client bundle at build time, so a change
# needs a rebuild rather than a restart.
# =============================================================================

# NEXT_PUBLIC_APP_NAME=Release Manager
# NEXT_PUBLIC_APP_TAGLINE=Plan and publish store updates
# NEXT_PUBLIC_APP_DESCRIPTION=
# Path under public/, or an absolute URL. Empty shows the app name alone.
# NEXT_PUBLIC_APP_LOGO=/commercetools-logo.svg
# NEXT_PUBLIC_APP_LOGO_ALT=commercetools

# =============================================================================
# OPTIONAL — catalog conventions
# =============================================================================

# The locale this console authors in: which locale of every LocalizedString it
# reads and writes, and how numbers, dates and money are formatted.
# NEXT_PUBLIC_LOCALE=en-US

# Currency offered first when adding a price, and the dashboard's reporting currency.
# NEXT_PUBLIC_CURRENCY=USD
# NEXT_PUBLIC_CURRENCIES=USD,EUR,GBP,CAD,MXN,BRL
# NEXT_PUBLIC_COUNTRIES=US,CA,MX,BR,GB,DE,FR,ES
# NEXT_PUBLIC_COUNTRY=US

# Multipliers into NEXT_PUBLIC_CURRENCY, for summing multi-currency orders on the
# dashboard. Indicative only — the dashboard labels its totals as approximate.
# NEXT_PUBLIC_FX_RATES=USD=1,EUR=1.08,GBP=1.27,CAD=0.73,MXN=0.058,BRL=0.18

# Product type assigned to products created by the wizard. Blank means the
# project's first product type — set it explicitly on a multi-type catalog.
# NEW_PRODUCT_TYPE_KEY=

# =============================================================================
# OPTIONAL — featured product attributes
# Two attributes get first-class treatment: a low-cardinality FACET the catalog
# filters by, and a high-cardinality CODE shown as a secondary identifier. Set
# either name to empty and its column, filter, field and CSV column disappear.
# =============================================================================

# NEXT_PUBLIC_FACET_ATTRIBUTE=brand
# NEXT_PUBLIC_FACET_ATTRIBUTE_LABEL=Brand
# NEXT_PUBLIC_FACET_ATTRIBUTE_PLACEHOLDER=e.g. Acme

# NEXT_PUBLIC_CODE_ATTRIBUTE=partNumber
# NEXT_PUBLIC_CODE_ATTRIBUTE_LABEL=Part number
# NEXT_PUBLIC_CODE_ATTRIBUTE_SHORT_LABEL=Part #
# NEXT_PUBLIC_CODE_ATTRIBUTE_PLACEHOLDER=e.g. BP-1234

# NEXT_PUBLIC_PRODUCT_NAME_PLACEHOLDER=e.g. Front Brake Pads

# =============================================================================
# OPTIONAL — storefronts
# Each is empty by default and an unset link is simply not rendered: no "Sites"
# group in the sidebar, no staging-preview button on a release.
# =============================================================================

# NEXT_PUBLIC_STAGING_STOREFRONT_B2C=
# NEXT_PUBLIC_STAGING_STOREFRONT_B2B=
# NEXT_PUBLIC_PRODUCTION_STOREFRONT_B2C=
# NEXT_PUBLIC_PRODUCTION_STOREFRONT_B2B=

# =============================================================================
# OPTIONAL — demo login
# One-click sign-in as a seeded persona, for showing the review and approval gates
# without four sets of real credentials. Turn it off wherever people sign in as
# themselves: the buttons and the shared password disappear.
# =============================================================================

# NEXT_PUBLIC_DEMO_LOGIN=true
# NEXT_PUBLIC_DEMO_PASSWORD=123
# NEXT_PUBLIC_DEMO_USERS=[{"email":"admin@example.com","label":"Avery (Admin)","role":"admin"},{"email":"author@example.com","label":"Alex (Author)","role":"author"},{"email":"reviewer@example.com","label":"Riley (Reviewer)","role":"reviewer"},{"email":"publisher@example.com","label":"Pat (Publisher)","role":"publisher"}]
# NEXT_PUBLIC_DEMO_ADMIN_EMAIL=

# =============================================================================
# OPTIONAL — other
# =============================================================================

# The service's own alias for the authoring project, sent as ?project=.
# RELEASE_SERVICE_PROJECT=stage

# City used in seeded order addresses (tools/seed-*-orders.mjs). Omitted when blank.
# SEED_ADDRESS_CITY=
